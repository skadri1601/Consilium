{
  "info": {
    "name": "Consilium API",
    "description": "API collection for Consilium multi-agent debate platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Readiness Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": ["{{baseUrl}}"],
              "path": ["health", "ready"]
            }
          }
        }
      ]
    },
    {
      "name": "Debates",
      "item": [
        {
          "name": "Create Debate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"Build a REST API with authentication using Node.js and PostgreSQL\",\n  \"models\": [\"gpt-5.4-mini\", \"claude-haiku-4-5-20251001\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/debates",
              "host": ["{{baseUrl}}"],
              "path": ["debates"]
            }
          }
        },
        {
          "name": "List Debates",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/debates?limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["debates"],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          }
        },
        {
          "name": "Get Debate",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/debates/:id",
              "host": ["{{baseUrl}}"],
              "path": ["debates", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "debate-123"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "API Keys",
      "item": [
        {
          "name": "Get API Keys",
          "request": {
            "method": "GET",
            "header": [
              {
