                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"openai\",\n  \"key\": \"sk-...\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api-keys/test",
              "host": ["{{baseUrl}}"],
              "path": ["api-keys", "test"]
            }
          }
        }
      ]
    },
