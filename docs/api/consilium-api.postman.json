                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"openaiKey\": \"sk-...\",\n  \"anthropicKey\": \"sk-ant-...\",\n  \"googleKey\": \"AIza...\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api-keys",
              "host": ["{{baseUrl}}"],
              "path": ["api-keys"]
            }
          }
        },
        {
          "name": "Test API Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
