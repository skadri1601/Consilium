# ===========================================
# Consilium - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# ----- Database (Neon PostgreSQL) -----
# Get from: https://console.neon.tech → Project → Connect
DATABASE_URL="postgresql://consilium:consilium_dev@localhost:5432/consilium"
DIRECT_URL="postgresql://consilium:consilium_dev@localhost:5432/consilium"
DIRECT_DATABASE_URL="postgresql://consilium:consilium_dev@localhost:5432/consilium"

POSTGRES_USER="consilium"
POSTGRES_PASSWORD="your_postgres_password_here"
POSTGRES_DB="consilium"
POSTGRES_PORT="5432"

# ----- Redis (Upstash) -----
# Get from: https://console.upstash.com → Database → Details
REDIS_URL="redis://localhost:6379"
REDIS_PORT="6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""

# ----- LLM Provider API Keys -----
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your_key_here"

# Anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-your_key_here"

# Google: https://aistudio.google.com/apikey
GOOGLE_API_KEY="your_key_here"

# Groq: https://console.groq.com (free tier)
GROQ_API_KEY="gsk_your_key_here"
GROQ_PLATFORM_KEY="gsk_your_key_here"

# xAI (Grok): https://console.x.ai
XAI_API_KEY="xai-your_key_here"

# Moonshot (Kimi): https://platform.moonshot.ai
MOONSHOT_API_KEY="sk-your_key_here"

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-your_key_here"

# ----- Consilium Free-Tier Fallback Pool (platform-hosted) -----
# Used ONLY when a user dispatches a debate without their own BYOK key
# for the requested provider. BYOK always takes precedence. Distinct
# from the provider env vars above so operators can run a shared
# free-tier pool without exposing their personal provider keys.
# Groq is preferred; OpenRouter is the backup.
CONSILIUM_FREE_TIER_GROQ_KEY=""
CONSILIUM_FREE_TIER_OPENROUTER_KEY=""

# ----- Authentication (Clerk) -----
# Get from: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_key_here"
CLERK_SECRET_KEY="sk_test_your_key_here"
CLERK_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/council"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/council"

# ----- Monitoring (Sentry) -----
# Get from: https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG="consilium-pi"
SENTRY_PROJECT="javascript-nextjs"

# ----- Payments (Stripe) -----
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""

# ----- Email (Resend) -----
# Get from: https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# ----- Application URLs -----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"
AGENTS_URL="http://localhost:8000"
CORS_ORIGINS="http://localhost:3000,http://localhost:4000"

# ----- Backend API Configuration -----
NODE_ENV="development"
PORT="4000"
API_PORT="4000"
API_PREFIX="api/v1"
# Enqueue debate start via BullMQ (same SSE URL once workers run; debate may stay pending until the job runs)
DEBATE_USE_QUEUE="false"
# Verbose API logs (SSE per-event lines, debate start line); also sets Fastify log level to debug when LOG_LEVEL is unset
API_DEBUG="false"
# Fastify / pino level: trace, debug, info, warn, error, fatal (overrides API_DEBUG default)
LOG_LEVEL="info"

# ----- AI Workers Configuration -----
AI_WORKERS_URL="http://localhost:8000"
BACKEND_API_URL="http://localhost:4000"
AGENTS_PORT="8000"
WEB_PORT="3000"

# ----- Security -----
# JWT_SECRET: use >=256 bits (32 random bytes). Examples: openssl rand -hex 32 (64 hex chars) or openssl rand -base64 32.
JWT_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_EXPIRATION="7d"
# ENCRYPTION_KEY: exactly 32 bytes as 64 hex chars (openssl rand -hex 32). Do not reuse the sample in production.
ENCRYPTION_KEY="fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"
INTERNAL_API_SECRET="your_internal_api_secret_here"
# INTERNAL_WEBHOOK_SECRET: 64 hex chars (openssl rand -hex 32).
INTERNAL_WEBHOOK_SECRET="aabbccddeeff00112233445566778899aabbccddeeff00112233445566778899"

# ----- Analytics (Optional) -----
# Get from: https://posthog.com → Project Settings
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ----- IndexNow (AEO / Bing-Yandex fast indexing, optional) -----
# Generate with: openssl rand -hex 16
# Hosted ownership-proof file is auto-served at /indexnow.txt
INDEXNOW_KEY=""

# ----- Langfuse (LLM Observability) -----
# Get from: https://cloud.langfuse.com → Settings → API Keys
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"

# ----- Webhook → Linear auto-ticketing -----
# Sentry → Linear webhook (created by webhooks/sentry endpoint)
# Set the same secret in Sentry Internal Integration → Webhook → "Client Secret"
SENTRY_WEBHOOK_SECRET=

# SonarQube → Linear webhook (created by webhooks/sonarqube endpoint)
# Set the same secret in Sonar admin → Webhooks → "Secret"
SONARQUBE_WEBHOOK_SECRET=

# Linear ticket creation (used by webhook handlers in apps/api)
# Same key as linear-sync.yml; mirror it to API runtime env
LINEAR_API_KEY=
# Optional: skip team lookup by hardcoding the team ID
LINEAR_TEAM_ID=
# Team key prefix used for fallback team lookup when LINEAR_TEAM_ID is unset
LINEAR_TICKET_PREFIX=MYC
# Comma-separated workflow state name fallbacks for new bug tickets
LINEAR_TRIAGE_STATE_NAMES=Triage,To Triage,Backlog
# Label names applied to auto-filed tickets based on payload environment
LINEAR_LABEL_ENV_PROD=env:prod
LINEAR_LABEL_ENV_DEV=env:dev
