{
  "name": "consilium",
  "version": "0.1.0",
  "private": true,
  "description": "AI Council Platform - Multi-AI agent orchestration system",
  "scripts": {
    "consilium": "pnpm -C packages/cli dev --",
    "cli:install": "pnpm -C packages/cli build && npm install -g ./packages/cli",
    "dev": "turbo dev --filter=@consilium/web --filter=@consilium/api",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "test:integration": "turbo test:integration",
    "test:e2e": "turbo test:e2e",
    "test:coverage": "turbo test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate": "pnpm --filter @consilium/database db:migrate",
    "db:generate": "pnpm --filter @consilium/database db:generate",
    "db:push": "pnpm --filter @consilium/database db:push",
    "db:studio": "pnpm --filter @consilium/database db:studio",
    "env:sync": "node -e \"require('fs').copyFileSync('.env.local', '.env'); console.log('✓ Synced .env.local → .env')\"",
    "clean": "turbo clean && rm -rf node_modules",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "prettier": "^3.8.3",
    "prisma": "^6.19.1",
    "turbo": "^2.9.9",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@sentry/nextjs": "^10.53.1"
  },
  "pnpm": {
    "overrides": {
      "handlebars": ">=4.7.9",
      "serialize-javascript": ">=7.0.3",
      "rollup": ">=4.59.0",
      "hono": ">=4.12.4",
      "@hono/node-server": ">=1.19.10",
      "defu": ">=6.1.5",
      "lodash": ">=4.18.0",
      "effect": ">=3.20.0",
      "protobufjs": ">=7.5.5",
      "minimatch@>=10.0.0": ">=10.2.3",
      "minimatch@>=9.0.0 <10.0.0": ">=9.0.7",
      "minimatch@>=3.0.0 <4.0.0": "3.1.2",
      "picomatch": ">=4.0.4",
      "micromatch>picomatch": "^2.3.1",
      "flatted": ">=3.4.2",
      "path-to-regexp": ">=8.4.0",
      "@isaacs/brace-expansion": ">=5.0.1",
      "@clerk/shared@>=4.0.0": ">=4.8.3",
      "@clerk/shared@>=3.0.0 <4.0.0": ">=3.47.5",
      "@clerk/shared@>=2.20.17 <3.0.0": ">=2.22.1",
      "fastify": ">=5.8.5"
    }
  }
}
