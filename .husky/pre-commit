#!/usr/bin/env sh

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --no-banner --redact || {
    echo ""
    echo "gitleaks detected potential secrets in staged changes."
    echo "Review the findings above. If a finding is a false positive, add it to .gitleaksignore."
    echo "To bypass (NOT recommended), commit with --no-verify."
    exit 1
  }
else
  echo "gitleaks not installed — skipping secret scan."
  echo "Install: https://github.com/gitleaks/gitleaks (brew install gitleaks)"
fi
