#!/usr/bin/env sh

set -e

echo "→ pnpm lint"
pnpm lint

echo "→ pnpm type-check"
pnpm type-check

if command -v pnpm >/dev/null 2>&1; then
  echo "→ pnpm audit (critical only)"
  pnpm audit --audit-level=critical || {
    echo "⚠ pnpm audit found issues. Dependabot handles transitive dep updates."
  }
fi
