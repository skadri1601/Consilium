# Gmail
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKENS_DIR=./tokens

# GitHub
GITHUB_TOKEN=ghp_xxxxx
GITHUB_REPO=owner/repo

# Stripe
STRIPE_SECRET_KEY=sk_live_xxxxx

# Resend
RESEND_API_KEY=re_xxxxx

# Sentry (optional)
SENTRY_DSN=

# Model
DEFAULT_MODEL=sonnet
