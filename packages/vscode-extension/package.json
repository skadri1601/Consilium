{
  "name": "consilium-vscode",
  "displayName": "Consilium - AI Council",
  "description": "Multi-AI debate, deliberation, and red-team assessments inside VS Code and Cursor.",
  "version": "0.1.0",
  "publisher": "myconsilium",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/skadri1601/Consilium",
    "directory": "packages/vscode-extension"
  },
  "homepage": "https://myconsilium.xyz",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "debate",
    "deliberation",
    "multi-agent",
    "council",
    "consilium",
    "llm",
    "chatgpt",
    "claude",
    "gemini"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "consilium",
          "title": "Consilium",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "consilium": [
        {
          "type": "webview",
          "id": "consilium.chat",
          "name": "Council",
          "icon": "media/icon.svg",
          "contextualTitle": "Consilium"
        },
        {
          "id": "consilium.sessions",
          "name": "Sessions",
          "icon": "$(history)"
        },
        {
          "id": "consilium.models",
          "name": "Models",
          "icon": "$(symbol-class)"
        }
      ]
    },
    "commands": [
      {
        "command": "consilium.login",
        "title": "Sign In",
        "category": "Consilium",
        "icon": "$(sign-in)"
      },
      {
        "command": "consilium.logout",
        "title": "Sign Out",
        "category": "Consilium",
        "icon": "$(sign-out)"
      },
      {
        "command": "consilium.debate",
        "title": "New Debate",
        "category": "Consilium",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "consilium.debateSelection",
        "title": "Debate Selection",
        "category": "Consilium",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "consilium.redTeamSelection",
        "title": "Red-Team Selection",
        "category": "Consilium",
        "icon": "$(shield)"
      },
      {
        "command": "consilium.deliberate",
        "title": "New Deliberation",
        "category": "Consilium",
        "icon": "$(symbol-event)"
      },
      {
        "command": "consilium.cancel",
        "title": "Cancel Active Session",
        "category": "Consilium",
        "icon": "$(stop-circle)"
      },
      {
        "command": "consilium.refresh",
        "title": "Refresh",
        "category": "Consilium",
        "icon": "$(refresh)"
      },
      {
        "command": "consilium.openSession",
        "title": "Open Session",
        "category": "Consilium"
      },
      {
        "command": "consilium.deleteSession",
        "title": "Delete Session",
        "category": "Consilium",
        "icon": "$(trash)"
      },
      {
        "command": "consilium.insertGoldenPrompt",
        "title": "Insert Golden Prompt at Cursor",
        "category": "Consilium",
        "icon": "$(insert)"
      },
      {
        "command": "consilium.openSettings",
        "title": "Open Settings",
        "category": "Consilium",
        "icon": "$(gear)"
      },
      {
        "command": "consilium.setProviderKey",
        "title": "Set Provider API Key (BYOK)",
        "category": "Consilium",
        "icon": "$(key)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "consilium.debate",
          "when": "view == consilium.chat",
          "group": "navigation@1"
        },
        {
          "command": "consilium.cancel",
          "when": "view == consilium.chat && consilium.active",
          "group": "navigation@2"
        },
        {
          "command": "consilium.openSettings",
          "when": "view == consilium.chat",
          "group": "navigation@9"
        },
        {
          "command": "consilium.refresh",
          "when": "view == consilium.sessions",
          "group": "navigation"
        },
        {
          "command": "consilium.refresh",
          "when": "view == consilium.models",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "consilium.openSession",
          "when": "view == consilium.sessions && viewItem == session",
          "group": "inline@1"
        },
        {
          "command": "consilium.deleteSession",
          "when": "view == consilium.sessions && viewItem == session",
          "group": "inline@2"
        }
      ],
      "editor/context": [
        {
          "submenu": "consilium.editor",
          "when": "editorHasSelection",
          "group": "1_modification@99"
        }
      ],
      "consilium.editor": [
        {
          "command": "consilium.debateSelection",
          "group": "1_consilium@1"
        },
        {
          "command": "consilium.redTeamSelection",
          "group": "1_consilium@2"
        }
      ],
      "commandPalette": [
        {
          "command": "consilium.debateSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "consilium.redTeamSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "consilium.insertGoldenPrompt",
          "when": "editorIsOpen"
        }
      ]
    },
    "submenus": [
      {
        "id": "consilium.editor",
        "label": "Consilium"
      }
    ],
    "keybindings": [
      {
        "command": "consilium.debateSelection",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "editorHasSelection"
      },
      {
        "command": "consilium.redTeamSelection",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorHasSelection"
      },
      {
        "command": "consilium.debate",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      }
    ],
    "configuration": {
      "title": "Consilium",
      "properties": {
        "consilium.apiUrl": {
          "type": "string",
          "default": "https://api.myconsilium.xyz",
          "description": "Base URL of the Consilium API (no path suffix). HTTP routes live under /api/v1."
        },
        "consilium.webUrl": {
          "type": "string",
          "default": "https://myconsilium.xyz",
          "description": "Base URL of the Consilium web app (used to open the sign-in page)."
        },
        "consilium.defaultMode": {
          "type": "string",
          "enum": [
            "quick",
            "council",
            "deep",
            "blind",
            "redteam",
            "jury",
            "market",
            "auto"
          ],
          "default": "council",
          "description": "Default debate mode for new sessions."
        },
        "consilium.defaultModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "gpt-5.4-mini",
            "claude-haiku-4-5-20251001",
            "gemini-3-flash-preview"
          ],
          "description": "Default list of model IDs to participate in a debate (2-5)."
        },
        "consilium.includeWorkspaceContext": {
          "type": "boolean",
          "default": true,
          "description": "Include workspace files, framework metadata, and git diff as projectContext on each request."
        },
        "consilium.contextBudgetKB": {
          "type": "number",
          "default": 512,
          "minimum": 16,
          "maximum": 2048,
          "description": "Maximum size in KB of workspace context payload sent with debates."
        },
        "consilium.respectGitIgnore": {
          "type": "boolean",
          "default": true,
          "description": "Exclude files matched by .gitignore when scanning workspace context."
        },
        "consilium.autoApplyGoldenPrompt": {
          "type": "boolean",
          "default": false,
          "description": "Automatically open the judge's golden prompt as a diff once consensus is reached."
        }
      }
    },
    "configurationDefaults": {
      "[markdown]": {}
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "echo 'vscode extension requires separate npm install; skipping'",
    "lint": "echo 'no eslint config; skipping'",
    "package": "vsce package --no-dependencies --out dist/consilium-vscode.vsix",
    "vscode:prepublish": "tsup --minify"
  },
  "dependencies": {
    "@consilium/shared": "workspace:*",
    "@myconsilium/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.120.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
