// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User & Authentication
// ============================================

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  imageUrl  String?
  tenantId  String

  // API Keys (encrypted, for BYOK)
  openaiKey    String? // Encrypted
  anthropicKey String? // Encrypted
  googleKey    String? // Encrypted
  groqKey      String? // Encrypted
  xaiKey       String? // Encrypted

  // CLI access: hash of long-lived token (user generates in Settings)
  cliTokenHash String? @unique

  // Relations
  conversations    Conversation[]
  conversationsV2  ConversationV2[]
  agents           Agent[]
  debateSessions   DebateSession[]
  personas         AgentPersona[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clerkId])
  @@index([tenantId])
}

// ============================================
// AI Agents
// ============================================

model Agent {
  id          String  @id @default(cuid())
  name        String
  provider    String  // openai, anthropic, google, xai
  modelId     String
  description String?
  isActive    Boolean @default(true)
  tenantId    String

  // Relations
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses AgentResponse[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([userId])
}

// ============================================
// Conversations & Messages
// ============================================

model Conversation {
  id       String @id @default(cuid())
  title    String
  mode     String @default("visible") // blind, visible
  tenantId String

  // Relations
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([userId])
}

model Message {
  id      String @id @default(cuid())
  role    String // user, assistant, system
  content String @db.Text

  // Relations
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  responses      AgentResponse[]

  // Timestamps
  createdAt DateTime @default(now())

  @@index([conversationId])
}

model AgentResponse {
  id         String @id @default(cuid())
  content    String @db.Text
  tokensUsed Int    @default(0)
  latencyMs  Int    @default(0)
  cost       Float  @default(0)

  // Relations
  agentId   String
  agent     Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())

  @@index([agentId])
  @@index([messageId])
}

// ============================================
// Debate Sessions
// ============================================

model DebateSession {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic            String   @db.Text
  status           String   @default("pending")
  modelsUsed       Json     @default("[]")
  totalCost        Float    @default(0)
  goldenPrompt     String?  @db.Text
  mode             String?  @default("council")
  estimatedCost    Float?
  debateSource     String?  @default("web")
  synthesisMethod  String?
  judgeModel       String?
  improvementScore Float?
  projectContext   Json?
  queueJobId       String?
  conversationId   String?
  conversation     ConversationV2? @relation(fields: [conversationId], references: [id])

  rounds           DebateRound[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@index([userId, createdAt])
  @@index([status])
  @@index([conversationId])
}

model DebateRound {
  id          String          @id @default(cuid())
  sessionId   String
  session     DebateSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  roundNumber Int
  status      String          @default("pending")
  messages    DebateMessage[]

  createdAt   DateTime        @default(now())

  @@index([sessionId])
}

model DebateMessage {
  id               String      @id @default(cuid())
  roundId          String
  round            DebateRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  agentId          String
  modelUsed        String
  content          String      @db.Text
  promptTokens     Int         @default(0)
  completionTokens Int         @default(0)
  cost             Float        @default(0)
  latencyMs        Int         @default(0)

  createdAt        DateTime    @default(now())

  @@index([roundId])
}

// ============================================
// Council Sessions (Legacy - kept for backward compatibility)
// ============================================

model CouncilSession {
  id               String  @id @default(cuid())
  query            String  @db.Text
  mode             String  @default("visible")
  consensusScore   Float?
  selectedResponse String?
  tenantId         String

  // Timestamps
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ============================================
// Usage & Analytics
// ============================================

model UsageRecord {
  id         String   @id @default(cuid())
  tenantId   String
  agentId    String?
  tokens     Int
  cost       Float
  recordedAt DateTime @default(now())

  @@index([tenantId])
  @@index([recordedAt])
}

// ============================================
// Audit Logging
// ============================================

model AuthLog {
  id        String   @id @default(cuid())
  userId    String?
  event     String   // login_success, login_failed, logout, etc.
  ip        String?
  userAgent String?
  metadata  Json?
  severity  String   @default("low") // low, medium, high, critical
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([event])
  @@index([createdAt])
  @@index([severity])
}

// ============================================
// Custom Agent Personas
// ============================================

model AgentPersona {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  systemPrompt String  @db.Text
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ============================================
// Waitlist
// ============================================

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  metadata  Json?
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// ============================================
// Conversations V2
// ============================================

model ConversationV2 {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  decisionLog    Json?
  projectContext Json?
  deletedAt      DateTime?

  debates        DebateSession[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, createdAt])
}

// ============================================
// Prompt Cache
// ============================================

model PromptCache {
  id            String   @id @default(cuid())
  tenantId      String
  promptHash    String
  goldenPrompt  String   @db.Text
  modelsUsed    Json     @default("[]")
  debateId      String?
  hitCount      Int      @default(0)
  modelVersions Json?
  createdAt     DateTime @default(now())
  expiresAt     DateTime?

  @@unique([tenantId, promptHash])
  @@index([tenantId])
  @@index([promptHash])
}

// ============================================
// Agent Failures
// ============================================

model AgentFailure {
  id        String   @id @default(cuid())
  modelId   String
  provider  String
  errorType String
  debateId  String?
  createdAt DateTime @default(now())

  @@index([modelId])
  @@index([debateId])
  @@index([createdAt])
}
