{
  "name": "@myconsilium/cli",
  "version": "0.2.0",
  "description": "CLI for Consilium AI Council - Multi-agent debate platform",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "consilium": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node18 --shims --clean",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "deliberation",
    "multi-agent",
    "debate",
    "consilium",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/skadri1601/Consilium",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/skadri1601/Consilium#readme",
  "bugs": {
    "url": "https://github.com/skadri1601/Consilium/issues"
  },
  "author": "Saad Kadri <saad@myconsilium.xyz>",
  "license": "MIT",
  "dependencies": {
    "ansi-escapes": "^6.2.1",
    "chalk": "^5.3.0",
    "cli-spinners": "^2.9.2",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "eventsource": "^2.0.2",
    "log-update": "^8.0.0",
    "open": "^10.1.0",
    "ora": "^8.0.1",
    "string-width": "^7.2.0",
    "wrap-ansi": "^9.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/eventsource": "^1.1.15",
    "@types/node": "^20.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
