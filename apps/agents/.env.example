# Consilium agents service (FastAPI) env vars.
# Copy to apps/agents/.env for local dev. The agents service reads
# these directly — they are NOT forwarded by the Nest API.

# ----- Provider API Keys (self-hosted, single-tenant) -----
# When set, these are used for every debate that hits this agent
# service if the caller did not supply BYOK keys in the request.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""
GROQ_API_KEY=""
XAI_API_KEY=""
MOONSHOT_API_KEY=""
OPENROUTER_API_KEY=""

# ----- Consilium Free-Tier Fallback Pool (platform-hosted) -----
# Resolution order per request (see src/features/free_tier/resolver.py):
#   1. User's BYOK key (request.api_keys)
#   2. Provider env var above (self-hosted deployments)
#   3. CONSILIUM_FREE_TIER_GROQ_KEY            (tier-equivalent Llama / gpt-oss)
#   4. CONSILIUM_FREE_TIER_OPENROUTER_KEY      (tier-equivalent free models)
# Without BYOK or self-hosted keys, at least one of these must be set,
# otherwise no-key requests return NoKeyAvailableError.
CONSILIUM_FREE_TIER_GROQ_KEY=""
CONSILIUM_FREE_TIER_OPENROUTER_KEY=""

# ----- Redis (optional; for caching and session state) -----
REDIS_URL=""

# ----- Logging -----
LOG_LEVEL="INFO"
