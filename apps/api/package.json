{
  "name": "@consilium/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "npx nest build",
    "dev": "npx nest start --watch",
    "start": "npx nest start",
    "start:dev": "npx nest start --watch",
    "start:debug": "npx nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "pnpm -C ../../packages/database db:generate",
    "prisma:migrate": "pnpm -C ../../packages/database db:migrate",
    "prisma:push": "pnpm -C ../../packages/database db:push",
    "prisma:studio": "pnpm -C ../../packages/database db:studio",
    "db:push": "pnpm prisma:push",
    "db:generate": "pnpm prisma:generate",
    "backfill:clerk-users": "tsx src/scripts/backfill-clerk-users.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.4.13",
    "@consilium/database": "workspace:*",
    "@fastify/static": "^9.1.3",
    "@nestjs-modules/ioredis": "^2.2.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.23",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.23",
    "@nestjs/platform-fastify": "^11.1.23",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/terminus": "^11.1.1",
    "@sentry/node": "^10.53.1",
    "bullmq": "^5.77.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.8.5",
    "ioredis": "^5.10.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.3",
    "rxjs": "^7.8.2",
    "stripe": "^22.1.1",
    "svix": "^1.94.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.23",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.33",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
